{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 800, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // 本次上游整合保留既有职责完整的实现；这些文件超 800 行只告警，不机械拆分。
      "files": [
        // Файловая адаптерная база: 1644 эффективных строки ещё до локальных правок
        // (обход дерева вынесен в fs/walk-files.ts). Остаток — port-поверхность двух
        // провайдеров поиска и атомарной записи; дробление требует отдельного рефактора,
        // поэтому превышение отслеживается предупреждением.
        // Центральный каталог профилей: контракты ролей держим одним owner-файлом,
        // поэтому превышение 800 строк отслеживаем warning'ом, а не механическим split.
        // 包级 lint 以包目录为 cwd，补充同一组文件的相对路径匹配。
      ],
      "rules": {
        "max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": [
        "**/i18n/locales/*.ts"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      // Legacy-паттерны: удаление спреда/перенос finally/eval меняют семантику и требуют
      // отдельного рефакторинга с тестами. Регистрируем как принятый долг, как max-lines.
      "files": [
        "apps/zcode-cli/packages/adapters/src/config/config-merger.ts",
        "apps/zcode-cli/packages/adapters/src/logging/serialize.ts",
        "apps/zcode-cli/packages/adapters/src/mcp/oauth-refresh.ts",
        "apps/zcode-cli/packages/adapters/src/mcp/pool.ts",
        "apps/zcode-cli/packages/adapters/src/mcp/resource-subscriptions.ts",
        "apps/zcode-cli/packages/adapters/src/model/runner-normalization.ts",
        "apps/zcode-cli/packages/adapters/src/plugins/official-marketplace.ts",
        "apps/zcode-cli/packages/adapters/src/storage/session-store/sqlite-session-store.ts",
        "apps/zcode-cli/packages/bootstrap/src/zcode-protocol/storage-startup.ts",
        "apps/zcode-cli/packages/core/src/runtime-task/workflow-blocked-reminder.ts",
        "apps/zcode-cli/packages/dynamic-workflow/tests/lowering/expected/holes.js",
        "src/config/config-merger.ts",
        "src/logging/serialize.ts",
        "src/mcp/oauth-refresh.ts",
        "src/mcp/pool.ts",
        "src/mcp/resource-subscriptions.ts",
        "src/model/runner-normalization.ts",
        "src/plugins/official-marketplace.ts",
        "src/runtime-task/workflow-blocked-reminder.ts",
        "src/storage/session-store/sqlite-session-store.ts",
        "src/zcode-protocol/storage-startup.ts",
        "tests/lowering/expected/holes.js"
      ],
      "rules": {
        "eslint/no-eval": "off",
        "eslint/no-unsafe-finally": "off",
        "unicorn/no-useless-fallback-in-spread": "off",
        "unicorn/no-useless-spread": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".claude/skills",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "packages/zcode-cua",
    "docs/electron"
  ]
}
