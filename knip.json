{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "workspaces": {
    "packages/ui": {
      "entry": [
        "test/**/*.test.tsx"
      ]
    },
    "packages/desktop": {
      "entry": [
        "scripts/**/*.{mjs,cjs,js,ts,mts}",
        "src/renderer/cuaPermissionPanel.ts",
        "src/renderer/src/plugin-sandbox/**/*.ts",
        "src/renderer/src/resource-manager.tsx"
      ],
      "ignoreDependencies": [
        "esbuild",
        "@opentelemetry/otlp-transformer"
      ],
      "ignore": [
        "scripts/*-fixture/**",
        "src/**/*.d.ts"
      ]
    },
    "apps/zcode-cli/packages/dynamic-workflow": {
      "entry": [
        "tests/**/*.test.ts"
      ],
      "ignore": [
        "tests/graphs/**",
        "tests/lowering/**",
        "tests/schemas/**",
        "tests/schema-errors/**",
        "tests/workflows/**",
        "tests/smoke/**"
      ]
    },
    "apps/zcode-cli/packages/office-runtime": {
      "ignore": [
        "ui/**",
        "src/adapters/**"
      ]
    },
    "apps/zcode-cli": {
      "entry": [
        "e2e/**/*.mjs",
        "scripts/**/*.mjs"
      ]
    },
    "packages/zcode-server-cli": {
      "entry": [
        "scripts/**/*.mjs"
      ]
    },
    ".": {
      "entry": [
        "scripts/**/*.{mjs,cjs,ts,mts}",
        ".vscode/*.mjs"
      ]
    },
    "packages/server": {
      "entry": [
        "src/entry-stdio.ts"
      ]
    }
  },
  "ignore": [
    ".agents/**",
    ".claude/**",
    "docs/**",
    "packages/ui/src/components/**",
    "**/dist-types/**",
    "**/skills/**",
    "**/module.ts",
    "**/contract.example.ts",
    "packages/ui/test/fixtures/**",
    "packages/ui/test/browser/**",
    "apps/zcode-cli/packages/adapters/tests/fixtures/**",
    "apps/zcode-cli/packages/core/tests/fixtures/**",
    "apps/zcode-cli/tests/gb2312.js",
    "packages/rpc/examples/**"
  ],
  "ignoreDependencies": [
    "d3-path",
    "tailwind-scrollbar-hide",
    "@modelcontextprotocol/sdk",
    "node-pty",
    "ws",
    "zod"
  ],
  "entry": [
    "scripts/**/*.{mjs,cjs,ts,mts}",
    ".vscode/*.mjs"
  ]
}
